#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Mateusz Okulanis
# SPDX-License-Identifier: GPL-3.0-or-later
# Run gpygap inside a container; all arguments go to gpygap.
#
# The project directory is mounted at the same path inside the container and
# used as the working directory, so gpygap.toml and relative paths behave the
# same inside and out. Directories outside the project (a USB drive for
# --export-delta, a mirror on another disk) are mounted the same way when
# listed in GPYGAP_MOUNTS, separated by colons:
#
#   GPYGAP_MOUNTS=/media/usb bin/gpygap sync --export-delta /media/usb/delta-2026-11
#
# GPYGAP_ENGINE=docker switches from podman to docker (CI runners have docker).
#
# A sync also builds the wheels upstream never published, each in its own
# sibling container, so the container needs to reach the engine. podman gets a
# transient API service that lives exactly as long as this script; docker
# already has a socket. Either way the container gets a socket and nothing
# else: it can start builder containers, which is what wheel building is.
# GPYGAP_NO_BUILD_SOCKET=1 withholds it, and gpygap then reports every target
# without an upstream wheel as a gap instead of filling it.
set -uo pipefail

project_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
image=${GPYGAP_IMAGE:-localhost/gpygap:latest}
engine=${GPYGAP_ENGINE:-podman}

# GPYGAP_STORAGE=<dir> keeps the container image store there instead of under
# the user's home. The builder images are several GB each and every build adds a
# layer, which is a lot to put on a system disk that is smaller than the mirror.
# Pointing it at the same disk as the mirror keeps the whole run on one volume.
if [[ -n ${GPYGAP_STORAGE:-} ]]; then
    mkdir -p "$GPYGAP_STORAGE/storage" "$GPYGAP_STORAGE/run"
    cat > "$GPYGAP_STORAGE/storage.conf" <<EOF
[storage]
driver = "overlay"
graphroot = "$GPYGAP_STORAGE/storage"
runroot = "$GPYGAP_STORAGE/run"
EOF
    export CONTAINERS_STORAGE_CONF="$GPYGAP_STORAGE/storage.conf"
fi

# Rebuilds only when the sources changed; otherwise served from the engine's cache.
"$engine" build --quiet --file "$project_dir/Containerfile" --tag "$image" "$project_dir" >/dev/null

mounts=(--volume "$project_dir:$project_dir")
IFS=: read -r -a extra_dirs <<<"${GPYGAP_MOUNTS:-}"
for dir in "${extra_dirs[@]}"; do
    [[ -n $dir ]] || continue
    mkdir -p "$dir"
    mounts+=(--volume "$dir:$dir")
done

# Files created in the mounts must belong to the calling user. podman does that
# with keep-id; docker needs the uid passed explicitly.
# label=disable: no SELinux relabelling of a mirror with tens of thousands of files.
engine_opts=()
if [[ $engine == *podman* ]]; then
    engine_opts+=(--userns=keep-id --security-opt label=disable)
else
    engine_opts+=(--user "$(id -u):$(id -g)")
fi

tty=()
[[ -t 0 && -t 1 ]] && tty=(--tty)

socket_in_container=/run/gpygap-engine.sock
socket_env=()
service_pid=
socket_dir=
cleanup() {
    [[ -n $service_pid ]] && kill "$service_pid" 2>/dev/null
    [[ -n $socket_dir ]] && rm -rf "$socket_dir"
    return 0
}

if [[ ${1:-} == sync && -z ${GPYGAP_NO_BUILD_SOCKET:-} ]]; then
    if [[ $engine == *podman* ]]; then
        socket_dir=$(mktemp -d)
        trap cleanup EXIT
        "$engine" system service --time=0 "unix://$socket_dir/podman.sock" &
        service_pid=$!
        for _ in $(seq 100); do
            [[ -S "$socket_dir/podman.sock" ]] && break
            sleep 0.1
        done
        if [[ -S "$socket_dir/podman.sock" ]]; then
            mounts+=(--volume "$socket_dir/podman.sock:$socket_in_container")
            # podman must be driven by its own client: a container created through
            # its Docker-compatible API comes up unable to fork.
            socket_env=(--env "CONTAINER_HOST=unix://$socket_in_container")
        else
            echo "gpygap: podman API service did not start; wheels will not be built" >&2
        fi
    elif [[ -S /var/run/docker.sock ]]; then
        mounts+=(--volume "/var/run/docker.sock:$socket_in_container")
        socket_env=(--env "DOCKER_HOST=unix://$socket_in_container")
        # The socket is group-owned; the container user must be in that group.
        docker_gid=$(stat -c '%g' /var/run/docker.sock)
        engine_opts+=(--group-add "$docker_gid")
    fi
fi

# Not exec: that would replace this shell and the trap above would never run, so the
# transient API service would outlive the run. One leaked service per sync adds up.
"$engine" run --rm --interactive "${tty[@]}" \
    "${engine_opts[@]}" \
    "${mounts[@]}" \
    "${socket_env[@]}" \
    --workdir "$project_dir" \
    "$image" "$@"
status=$?
cleanup
exit $status
